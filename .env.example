# WiFi credentials
# NOTE: The Pico W's CYW43439 chip is 2.4GHz only — use a 2.4GHz network.
# Avoid special characters in SSID or password if possible.
WIFI_SSID=your_network_name
WIFI_PASS=your_wifi_password

# MQTT broker address — use your Mac's WiFi IP (run: ipconfig getifaddr en0)
MQTT_ADDR=192.168.1.x:1883

# MQTT credentials (leave blank for anonymous/local Mosquitto)
MQTT_USER=
MQTT_PASS=
