# WiFi credentials
# NOTE: The Pico W's CYW43439 chip is 2.4GHz only — use a 2.4GHz network.
# Avoid special characters in SSID or password if possible.
WIFI_SSID=your_network_name
WIFI_PASS=your_wifi_password

# MQTT broker address — host:port only, no tcp:// prefix.
MQTT_ADDR=os-mqtt-gateway.fly.dev:1883

# MQTT credentials and routing.
# MQTT_USER and MQTT_DEVICE are required unless MQTT_TOPIC is set explicitly.
MQTT_USER=picopuff
MQTT_PASS=your_mqtt_password

# Stable backend device slug. Required for the default topic and must match devices.source_device_key in the API DB.
# For current custom registrations, use the lowercased MAC address entered during signup.
MQTT_DEVICE=aa:bb:cc:dd:ee:ff

# Optional full topic override. Leave blank for:
# louisianair/dev/<MQTT_USER>/<MQTT_DEVICE>/telemetry
MQTT_TOPIC=
